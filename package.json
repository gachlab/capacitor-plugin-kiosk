{
  "name": "@gachlab/capacitor-kiosk",
  "version": "2.1.1",
  "description": "Capacitor plugin for Android kiosk mode (Lock Task). Pin your app to the screen and prevent users from leaving.",
  "type": "module",
  "main": "./dist/plugin.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/"
  ],
  "author": "Guillermo Carrillo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gachlab/capacitor-plugin-kiosk.git"
  },
  "bugs": {
    "url": "https://github.com/gachlab/capacitor-plugin-kiosk/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "kiosk",
    "lock-task",
    "screen-pinning",
    "android"
  ],
  "scripts": {
    "verify": "npm run verify:android && npm run verify:web",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run prettier -- --check",
    "fmt": "npm run prettier -- --write",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "build": "npm run clean && tsc --emitDeclarationOnly && node build.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "test": "node --import tsx/esm --test src/__tests__/web.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@ionic/prettier-config": "^4.0.0",
    "prettier": "^3.8.0",
    "prettier-plugin-java": "^2.8.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "esbuild": "^0.28.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": "@ionic/prettier-config",
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}
